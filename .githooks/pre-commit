#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "=== LabRat AI: Ruff format check ==="
.venv/bin/ruff format --check .

echo
echo "=== LabRat AI: Ruff lint ==="
.venv/bin/ruff check .

echo
echo "=== LabRat AI: Unit tests ==="
.venv/bin/python -m unittest discover -s tests -v

echo
echo "All pre-commit checks passed."
